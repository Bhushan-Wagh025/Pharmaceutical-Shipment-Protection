# ==============================================================================
# PHARMACEUTICAL SHIPMENT PROTECTION AIoT — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Database Configuration
# In production, use managed PostgreSQL 15/16. Never expose DB ports directly to WAN.
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/pharma_protection
ENABLE_SQLITE_FALLBACK=false
SQLITE_FALLBACK_URL=sqlite:///./pharma_protection.db

# 2. Security & JWT Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=b2b-pharma-shipment-super-secret-key-2026-safe-production-jwt-token
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. Gateway Credential Encryption (At-Rest AES/Fernet)
# Key used to encrypt gateway passwords and API keys in PostgreSQL.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GATEWAY_ENCRYPTION_KEY=b2b-pharma-fernet-secret-encryption-key-32b

# 4. Anti-SSRF Policy
# Set to 'true' if BLE Gateways reside on RFC 1918 private subnets (e.g., 192.168.1.x, 10.x.x.x).
# Set to 'false' in cloud environments where private internal metadata or VPC services exist.
# Loopback (127.0.0.1) and AWS/Cloud metadata (169.254.169.254) are ALWAYS blocked unconditionally.
ALLOW_PRIVATE_GATEWAY_IPS=true

# 5. Cold-Chain Thermal Safety & Stale Telemetry Thresholds
DEFAULT_TEMP_SAFE=5.5
DEFAULT_TEMP_LIMIT=8.0
DEFAULT_FORECAST_HORIZON_MINUTES=15
DEFAULT_COOLING_TARGET=4.2
# Telemetry older than this threshold suspends automatic physical actuation to prevent false triggers
STALE_TELEMETRY_THRESHOLD_MINUTES=5

# 6. Redis & Caching
REDIS_URL=redis://localhost:6379/0

# 7. Frontend & CORS
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 8. Aperture Industrial BLE Gateway (Primary & Exclusive Live Data Source)
# Live Gateway APIs:
# Latest:  https://gateway.apertureventurestudio.com/api/v1/gateway/ble/telemetry/latest
# History: https://gateway.apertureventurestudio.com/api/v1/gateway/ble/telemetry/history
APERTURE_GATEWAY_URL=https://gateway.apertureventurestudio.com
APERTURE_BLE_LATEST_ENDPOINT=/api/v1/gateway/ble/telemetry/latest
APERTURE_BLE_HISTORY_ENDPOINT=/api/v1/gateway/ble/telemetry/history
NEXT_PUBLIC_APERTURE_GATEWAY_URL=https://gateway.apertureventurestudio.com
DEFAULT_GATEWAY_URL=https://gateway.apertureventurestudio.com
