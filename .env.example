# Database
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/pharma_protection
ENABLE_SQLITE_FALLBACK=true
SQLITE_FALLBACK_URL=sqlite:///./pharma_protection.db

# JWT & Authentication
SECRET_KEY=b2b-pharma-shipment-super-secret-key-2026-safe-production-jwt-token
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AIoT Thermal Thresholds
DEFAULT_TEMP_SAFE=5.5
DEFAULT_TEMP_LIMIT=8.0
DEFAULT_FORECAST_HORIZON_MINUTES=15
DEFAULT_COOLING_TARGET=4.2

# Redis Cache & Message Queue
REDIS_URL=redis://localhost:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
